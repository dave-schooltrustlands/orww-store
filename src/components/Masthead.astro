---
// Masthead — text-set wordmark in navy serif small-caps, with oxblood-italic tagline below.
---
<header class="bg-orww-paper border-b border-orww-rule">
  <div class="mx-auto max-w-wide px-4 sm:px-6 py-8 sm:py-10 text-center">
    <a href="/" class="no-underline">
      <h1
        class="font-serif font-semibold text-orww-navy text-3xl sm:text-4xl tracking-wide leading-tight"
        style="font-variant: small-caps; letter-spacing: 0.04em;"
      >
        Oregon Websites &amp; Watersheds Project
      </h1>
    </a>
    <p class="mt-2 font-serif italic text-orww-oxblood text-lg sm:text-xl max-w-measure mx-auto">
      Online Tools for the Study and Stewardship of Oregon's Watershed Resources
    </p>
  </div>
</header>

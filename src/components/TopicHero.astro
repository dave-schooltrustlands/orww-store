---
export interface Props {
  src?: string;
  alt: string;
  caption: string;
  placeholder?: boolean;
}

const { src, alt, caption, placeholder = false } = Astro.props;
---
<figure class="mb-10">
  {placeholder || !src ? (
    <div
      class="w-full aspect-[16/7] bg-orww-paper-soft border border-orww-rule flex items-center justify-center"
      role="img"
      aria-label={alt}
    >
      <p class="font-sans text-sm text-orww-ink-mute italic max-w-measure text-center px-6">
        {alt}
      </p>
    </div>
  ) : (
    <img
      src={src}
      alt={alt}
      loading="eager"
      decoding="async"
      class="w-full h-auto"
    />
  )}
  <figcaption class="mt-3 text-center font-sans italic text-orww-ink-mute text-sm max-w-measure mx-auto">
    {caption}
  </figcaption>
</figure>

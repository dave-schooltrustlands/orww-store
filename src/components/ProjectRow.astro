---
export interface Props {
  year: string;
  title: string;
  href: string;
  description: string;
  imageSrc?: string;
  imageAlt?: string;
}

const { year, title, href, description, imageSrc, imageAlt } = Astro.props;
---
<article class="border-b border-orww-rule py-6 md:py-8">
  <a href={href} class="no-underline group">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-6 items-start">
      <div class="md:col-span-2">
        {imageSrc ? (
          <img
            src={imageSrc}
            alt={imageAlt || ''}
            loading="lazy"
            class="w-full max-w-[160px] h-auto rounded-sm border border-orww-rule"
          />
        ) : (
          <div class="w-full max-w-[160px] aspect-[4/3] rounded-sm border border-orww-rule bg-orww-paper-soft" aria-hidden="true"></div>
        )}
      </div>
      <div class="md:col-span-1 font-sans text-orww-ink-mute text-sm tracking-wider">
        {year}
      </div>
      <div class="md:col-span-9">
        <h2 class="font-serif text-2xl text-orww-navy group-hover:text-orww-oxblood mb-2">
          {title}
        </h2>
        <p class="text-orww-ink leading-relaxed max-w-measure">
          {description}
        </p>
        <p class="mt-3 font-sans text-sm text-orww-oxblood group-hover:underline">
          Read more →
        </p>
      </div>
    </div>
  </a>
</article>

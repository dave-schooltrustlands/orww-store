---
import '../styles/globals.css';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description?: string;
  showHero?: boolean;
  heroVariant?: 'wide' | 'banner';
  heroSlot?: boolean;
  activeNav?: string;
}

const {
  title,
  description = 'Oregon Websites & Watersheds Project — a modern presentation layer over the ORWW archive at www.orww.org.',
  activeNav,
} = Astro.props;

const topicSlugs = [
  { slug: '/elliott/', label: 'Elliott State Forest' },
  { slug: '/osbornes/', label: 'Osbornes Project' },
  { slug: '/letitia-carson/', label: 'Letitia Carson' },
  { slug: '/umpqua-1828/', label: '1828 Umpqua / Jed Smith' },
];
const inTopic = activeNav === 'topics' || topicSlugs.some((t) => t.slug === Astro.url.pathname);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Serif:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap"
    />
  </head>
  <body class="bg-orww-paper text-orww-ink antialiased min-h-screen flex flex-col">
    <Masthead />

    <nav class="border-b border-orww-rule bg-orww-paper">
      <div class="mx-auto max-w-wide px-4 sm:px-6 py-3 flex flex-wrap items-center gap-x-6 gap-y-2 font-sans text-sm">
        <a href="/" class={`no-underline hover:underline ${activeNav === 'home' ? 'font-semibold' : ''}`}>Home</a>
        <a href="/about/" class={`no-underline hover:underline ${activeNav === 'about' ? 'font-semibold' : ''}`}>About</a>
        <details class="relative">
          <summary class={`cursor-pointer list-none select-none ${inTopic ? 'font-semibold' : ''}`}>
            Topics <span aria-hidden="true" class="text-orww-ink-mute">▾</span>
          </summary>
          <div class="absolute left-0 z-10 mt-2 w-64 rounded-sm border border-orww-rule bg-orww-paper shadow-md p-2">
            {topicSlugs.map((t) => (
              <a
                href={t.slug}
                class="block px-3 py-1.5 no-underline hover:bg-orww-paper-soft hover:underline"
              >
                {t.label}
              </a>
            ))}
          </div>
        </details>
        <a href="/contact/" class={`no-underline hover:underline ${activeNav === 'contact' ? 'font-semibold' : ''}`}>Contact</a>
        <span class="grow"></span>
        <a href="http://www.orww.org/" class="text-orww-ink-mute italic no-underline hover:underline">
          Canonical archive: www.orww.org →
        </a>
      </div>
    </nav>

    <main class="flex-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
